# Domovoy settings on the machine with the timers. Copy to .env; it is not committed.

# Where to wake the agent: your private chat with the Gonets bot (chat id).
# Empty = timers stay silent (fail-closed: a plan in the wrong chat is worse
# than no plan).
DOMOVOY_CHAT_ID=
DOMOVOY_THREAD_ID=

# Мастерская: тема для долгой работы (поиски, наряды из лички). Обе пусты: всё идёт
# в личке, как раньше; задана одна: ошибка запуска.
DOMOVOY_WORKSHOP_CHAT_ID=
DOMOVOY_WORKSHOP_THREAD_ID=

# Gonets event endpoint. Empty = http://127.0.0.1:8788/event.
DOMOVOY_BOT_URL=
# Gonets' APPROVE_SHARED_SECRET (X-Approve-Token), if the bot has one.
DOMOVOY_BOT_SECRET=

# Language of messages, prompts and diary headings: en (default) or ru.
DOMOVOY_LANG=en
# Time zone of the wake-up windows. Empty = system time zone (the timers use it too).
DOMOVOY_TZ=

# Obsidian vault for the diary. Empty = ~/Obsidian.
DOMOVOY_VAULT_DIR=

# Photos of the day from Immich into the diary (optional): both or nothing.
IMMICH_URL=
IMMICH_API_KEY=

# `domovoy.diary sessions` refuses inside client work: the author's setup checks
# this with his memory router. Without such a router the check always refuses,
# so it is off here. Set to on only if you have that setup.
DOMOVOY_CLIENT_BOUNDARY=off
